# -----------------------
# Prisma / Supabase (PostgreSQL)
# -----------------------
# URL "pooler" (transaction pooler) conseillée pour l'app (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# URL directe (non poolée) conseillée pour migrations/prisma studio
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# -----------------------
# Supabase (client)
# -----------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# (optionnel) Supabase (serveur) — utile pour Storage (URLs signées) si tu gardes NextAuth
# ⚠️ NE JAMAIS exposer cette clé côté navigateur
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# (optionnel) Bucket par défaut pour Supabase Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="uploads"

# -----------------------
# NextAuth
# -----------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# Google OAuth
GOOGLE_CLIENT_ID="change-me.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="change-me"

# -----------------------
# Stripe (abonnement Premium 1€/mois)
# -----------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_ID_PREMIUM_MONTHLY="price_..."
